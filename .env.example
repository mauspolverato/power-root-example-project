# Copy to .env and fill in. Never commit .env.

# Claude API — powers brand analysis and copywriting. Without it the pipeline
# still runs using deterministic heuristics (lower quality, zero cost).
ANTHROPIC_API_KEY=

# Optional: Google Places API (New). Without it, discovery uses OpenStreetMap
# (free, no key) or a CSV you provide.
GOOGLE_PLACES_API_KEY=

# Hard ceiling on Claude spend per pipeline run, in USD. The run stops calling
# the API once the estimate is reached.
MAX_AI_SPEND_PER_RUN_USD=5

# Where the SQLite database and generated demos live.
DATA_DIR=./data
OUTPUT_DIR=./output

# Public base URL where demos will be hosted (used in proposals). Leave the
# default while working locally.
PREVIEW_BASE_URL=http://localhost:4173

# Your agency identity — appears in demo banners and proposals.
AGENCY_NAME=Your Agency
AGENCY_EMAIL=hello@example.com
AGENCY_ADDRESS=Your postal address (required in commercial emails in many countries)

# Path to a Chromium binary for automated QA (Playwright). Leave empty to use
# Playwright's default lookup.
CHROMIUM_PATH=
